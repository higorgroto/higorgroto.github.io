---
import type { Lang } from '../i18n/ui';
import { t, defaultLang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

function getLangUrl(targetLang: Lang): string {
  const url = new URL(Astro.request.url);
  if (targetLang === defaultLang) {
    url.searchParams.delete('lang');
  } else {
    url.searchParams.set('lang', targetLang);
  }
  return url.pathname + url.search;
}
---

<div class="flex items-center gap-2 text-sm">
  <a 
    href={getLangUrl('pt')}
    class={lang === 'pt' ? 'text-white font-medium' : 'text-github-text-muted hover:text-github-text transition-colors'}
  >
    {t(lang, 'lang.pt')}
  </a>
  <span class="text-github-border">|</span>
  <a 
    href={getLangUrl('en')}
    class={lang === 'en' ? 'text-white font-medium' : 'text-github-text-muted hover:text-github-text transition-colors'}
  >
    {t(lang, 'lang.en')}
  </a>
</div>
