---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const navItems = [
  { id: 'projects', label: t(lang, 'nav.projects'), href: '#projects' },
  { id: 'about', label: t(lang, 'nav.about'), href: '#about' },
  { id: 'contact', label: t(lang, 'nav.contact'), href: '#contact' },
];

const contacts = [
  { icon: 'location', text: t(lang, 'sidebar.location'), href: null },
  { icon: 'email', text: t(lang, 'sidebar.email'), href: 'mailto:higor.groto@outlook.com' },
  { icon: 'github', text: t(lang, 'sidebar.github'), href: 'https://github.com/higorgroto' },
  { icon: 'linkedin', text: t(lang, 'sidebar.linkedin'), href: 'https://linkedin.com/in/higor-groto' },
  { icon: 'instagram', text: t(lang, 'sidebar.instagram'), href: 'https://instagram.com/higorgroto' },
];
---

<!-- Desktop Sidebar -->
<aside class="hidden lg:flex flex-col fixed left-0 top-0 h-screen w-sidebar bg-github-bg border-r border-github-border-subtle z-40">
  <div class="flex-1 overflow-y-auto px-7 py-10">
    <!-- Profile -->
    <div class="mb-8">
      <div class="w-20 h-20 rounded-full overflow-hidden mb-5 bg-github-bg-tertiary border border-github-border">
        <img 
          src="/images/profile-default.jpeg" 
          alt={t(lang, 'sidebar.name')} 
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <h1 class="text-lg font-semibold text-white leading-tight mb-1">{t(lang, 'sidebar.name')}</h1>
      <p class="text-sm text-github-text-secondary mb-3">{t(lang, 'sidebar.role')}</p>
      <p class="text-sm text-github-text-muted italic">{t(lang, 'sidebar.tagline')}</p>
    </div>

    <!-- Divider -->
    <div class="border-t border-github-border-subtle mb-6"></div>

    <!-- Contact -->
    <div class="mb-6">
      <ul class="space-y-2.5">
        {contacts.map((c) => (
          <li class="flex items-start gap-2.5 text-sm">
            {c.icon === 'location' && (
              <svg class="w-4 h-4 mt-0.5 text-github-text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
            )}
            {c.icon === 'email' && (
              <svg class="w-4 h-4 mt-0.5 text-github-text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
            )}
            {c.icon === 'github' && (
              <svg class="w-4 h-4 mt-0.5 text-github-text-muted shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            )}
            {c.icon === 'linkedin' && (
              <svg class="w-4 h-4 mt-0.5 text-github-text-muted shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            )}
            {c.icon === 'instagram' && (
              <svg class="w-4 h-4 mt-0.5 text-github-text-muted shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            )}
            {c.href ? (
              <a href={c.href} target="_blank" rel="noopener noreferrer" class="text-github-text-secondary hover:text-white transition-colors duration-200">{c.text}</a>
            ) : (
              <span class="text-github-text-secondary">{c.text}</span>
            )}
          </li>
        ))}
      </ul>
    </div>

    <!-- Divider -->
    <div class="border-t border-github-border-subtle mb-6"></div>

    <!-- Navigation -->
    <nav>
      <ul class="space-y-1">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href}
              class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-github-text-secondary hover:text-white hover:bg-github-bg-tertiary transition-all duration-200"
            >
              {item.id === 'projects' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" /></svg>
              )}
              {item.id === 'about' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
              )}
              {item.id === 'contact' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              )}
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Bottom -->
  <div class="px-7 py-6 border-t border-github-border-subtle">
    <LanguageSelector lang={lang} />
    <p class="text-xs text-github-text-muted mt-4">{t(lang, 'sidebar.copyright')}</p>
    <p class="text-xs text-github-text-muted">{t(lang, 'sidebar.rights')}</p>
  </div>
</aside>

<!-- Mobile Header -->
<header class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-github-bg/95 backdrop-blur-sm border-b border-github-border-subtle">
  <div class="flex items-center justify-between px-4 py-3">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full overflow-hidden bg-github-bg-tertiary border border-github-border">
        <img src="/images/profile-default.jpeg" alt={t(lang, 'sidebar.name')} class="w-full h-full object-cover" loading="eager" />
      </div>
      <div>
        <p class="text-sm font-semibold text-white leading-tight">{t(lang, 'sidebar.name')}</p>
        <p class="text-xs text-github-text-muted">{t(lang, 'sidebar.role')}</p>
      </div>
    </div>
    <button 
      id="mobile-menu-btn"
      class="p-2 rounded-md text-github-text-secondary hover:text-white hover:bg-github-bg-tertiary transition-colors"
      aria-label="Menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="hidden border-t border-github-border-subtle bg-github-bg-secondary">
    <nav class="px-4 py-4">
      <ul class="space-y-1">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="block px-3 py-2.5 rounded-md text-sm text-github-text-secondary hover:text-white hover:bg-github-bg-tertiary transition-colors">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="px-4 py-4 border-t border-github-border-subtle">
      <div class="space-y-2 text-sm">
        <a href="mailto:higor.groto@outlook.com" class="block text-github-text-secondary hover:text-white transition-colors">{t(lang, 'sidebar.email')}</a>
        <a href="https://github.com/higorgroto" target="_blank" rel="noopener noreferrer" class="block text-github-text-secondary hover:text-white transition-colors">{t(lang, 'sidebar.github')}</a>
        <a href="https://linkedin.com/in/higor-groto" target="_blank" rel="noopener noreferrer" class="block text-github-text-secondary hover:text-white transition-colors">{t(lang, 'sidebar.linkedin')}</a>
        <a href="https://instagram.com/higorgroto" target="_blank" rel="noopener noreferrer" class="block text-github-text-secondary hover:text-white transition-colors">{t(lang, 'sidebar.instagram')}</a>
      </div>
      <div class="mt-4 pt-4 border-t border-github-border-subtle">
        <LanguageSelector lang={lang} />
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      drawer.classList.toggle('hidden');
    });
    // Close drawer when clicking a link
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
      });
    });
  }
</script>
