---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
import { switchLangPath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const targetPt = switchLangPath(Astro.url.pathname, 'pt');
const targetEn = switchLangPath(Astro.url.pathname, 'en');
---

<div class="flex items-center gap-2 text-sm">
  <a
    href={targetPt}
    class={lang === 'pt' ? 'text-white font-medium' : 'text-github-text-muted hover:text-github-text transition-colors'}
  >
    {t(lang, 'lang.pt')}
  </a>
  <span class="text-github-border">|</span>
  <a
    href={targetEn}
    class={lang === 'en' ? 'text-white font-medium' : 'text-github-text-muted hover:text-github-text transition-colors'}
  >
    {t(lang, 'lang.en')}
  </a>
</div>
