---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  prev: { slug: string; title: string } | null;
  next: { slug: string; title: string } | null;
  lang: Lang;
}

const { prev, next, lang } = Astro.props;
const langParam = lang === 'en' ? '?lang=en' : '';
---

<nav class="mt-16 pt-8 border-t border-github-border-subtle">
  <div class="flex flex-col sm:flex-row justify-between gap-4">
    {prev ? (
      <a 
        href={`/projects/${prev.slug}${langParam}`}
        class="group flex items-center gap-3 text-github-text-secondary hover:text-white transition-colors"
      >
        <svg class="w-5 h-5 shrink-0 text-github-text-muted group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
        <div>
          <span class="block text-xs text-github-text-muted mb-0.5">{t(lang, 'project.prev')}</span>
          <span class="text-sm font-medium">{prev.title}</span>
        </div>
      </a>
    ) : <div />}

    {next ? (
      <a 
        href={`/projects/${next.slug}${langParam}`}
        class="group flex items-center gap-3 text-github-text-secondary hover:text-white transition-colors text-right sm:text-left"
      >
        <div>
          <span class="block text-xs text-github-text-muted mb-0.5">{t(lang, 'project.next')}</span>
          <span class="text-sm font-medium">{next.title}</span>
        </div>
        <svg class="w-5 h-5 shrink-0 text-github-text-muted group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
      </a>
    ) : <div />}
  </div>
</nav>
