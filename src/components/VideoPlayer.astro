---
import type { Lang } from '../i18n/ui';

interface Props {
  video: {
    type: 'local' | 'youtube';
    src: string;
    title?: string;
    title_en?: string;
    poster?: string;
  };
  lang: Lang;
  compact?: boolean;
}

const { video, lang, compact = false } = Astro.props;

const title = lang === 'en' && video.title_en ? video.title_en : (video.title || '');
---

<div class={compact ? '' : 'my-6'}>
  {video.type === 'youtube' ? (
    <div class="aspect-video rounded-image overflow-hidden bg-github-bg-tertiary">
      <iframe
        src={`https://www.youtube.com/embed/${video.src}`}
        title={title}
        class="w-full h-full"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  ) : (
    <div class="flex justify-center rounded-image overflow-hidden bg-github-bg-tertiary">
      <video
        controls
        class={compact ? 'w-full aspect-[9/16] object-contain bg-black' : 'max-w-full max-h-[75vh]'}
        preload={video.poster ? 'none' : 'metadata'}
        poster={video.poster}
        playsinline
      >
        <source src={video.src} type="video/mp4" />
      </video>
    </div>
  )}
  {title && (
    <p class="mt-2 text-sm text-github-text-muted text-center">{title}</p>
  )}
</div>
